{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "airbuild": {
      "type": "streamable-http",
      "url": "https://mcp.air.build/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://air.build/oauth/authorize",
            "tokenUrl": "https://air.build/oauth/token",
            "baseScopes": ["airbuild"]
          }
        }
      }
    }
  }
}
